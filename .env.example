# ---------------------------------------------------------------------------
# Server-only. Read by /api/ice, never shipped to the browser.
# ---------------------------------------------------------------------------

# STUN list, comma separated. Defaults to Google's public STUN if unset.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relay(s), comma separated. Required for peers behind symmetric NATs.
# Use turns: (TLS) in production; WebRTC only works over https anyway.
#TURN_URLS=turns:turn.example.com:443?transport=tcp

# PREFERRED: shared secret -> short-lived credentials per the TURN REST API
# (RFC 9359). The server returns username="<expiry>:<id>" and
# credential=base64(HMAC-SHA1(TURN_SECRET, username)). Works with coturn's
# `use-auth-secret` + `static-auth-secret`.
#TURN_SECRET=change-me

# Fallback: static credentials, sent as-is. Only use these if your relay cannot
# do ephemeral credentials.
#TURN_USERNAME=
#TURN_CREDENTIAL=

# Lifetime in seconds for the credentials handed out (120 – 43200).
# Capped at 1200s when TURN_SECRET is used.
#ICE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Public. Inlined into the client bundle at build time (NEXT_PUBLIC_*).
# ---------------------------------------------------------------------------

# STUN override used by the browser when /api/ice is unreachable.
#NEXT_PUBLIC_STUN_URLS=

# Signalling server. Leave blank to use the free PeerJS cloud (0.peerjs.com).
# For a self-hosted peerjs-server, set host/port/path/secure to match it.
#NEXT_PUBLIC_PEERJS_HOST=0.peerjs.com
#NEXT_PUBLIC_PEERJS_PORT=443
#NEXT_PUBLIC_PEERJS_PATH=/
#NEXT_PUBLIC_PEERJS_SECURE=true

# Log PeerJS warnings and errors to the console.
#NEXT_PUBLIC_PEERJS_DEBUG=false
